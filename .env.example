# MCPocket configuration — copy to `.env` (Docker Compose) or `.env.local`
# (`npm run dev`) and adjust. Every variable is optional unless marked
# REQUIRED; the value shown is the default unless noted. Never commit `.env`.
# Docker Compose interpolates `$` in values: write a literal `$` as `$$`.

# ---------------------------------------------------------------------------
# Docker Compose (host side only)
# ---------------------------------------------------------------------------
# Host port the app is published on (container always listens on 3000).
MCPOCKET_PORT=3000
# Tag of the locally built image `mcpocket:<tag>`.
MCPOCKET_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# `json` (default: one file per collection), `sqlite` (one database file,
# built-in node:sqlite — no extra container) or `mongo` (external MongoDB).
# Moving existing JSON data to SQLite: `npm run migrate:sqlite` (see README).
STORAGE_DRIVER=json
# Data directory. Compose pins it to /app/data (the `mcpocket-data`
# volume); for `npm run dev` the default is ./data.
# DATA_DIR=./data
# SQLite database file (STORAGE_DRIVER=sqlite), relative to DATA_DIR.
# SQLITE_FILE=mcpocket.db
# MongoDB (STORAGE_DRIVER=mongo): connection string (REQUIRED for mongo) and
# database name (default mcpocket).
# MONGODB_URI=mongodb://user:pass@localhost:27017/?w=majority
# MONGODB_DB=mcpocket
# docker-compose.prod.yml (app + MongoDB 8) builds MONGODB_URI itself from
# these; REQUIRED there. URL-safe values: `openssl rand -hex 24`.
# MONGO_ROOT_USERNAME=root
# MONGO_ROOT_PASSWORD=
# MONGO_APP_USERNAME=mcpocket
# MONGO_APP_PASSWORD=
# Host loopback port MongoDB is published on (127.0.0.1 only).
# MONGO_PORT=27017
# Workspace (tenant) this instance serves. Lets many instances (one per
# workspace, e.g. MCPocket Cloud) share one MongoDB database (documents carry
# a `workspace` field; mongo driver default `default`) and one S3 bucket
# (media under <MCPOCKET_MEDIA_PREFIX><workspace>/). Default:
# MCPOCKET_SSO_WORKSPACE, else none.
# MCPOCKET_WORKSPACE=
# Cloud mode: ONE instance serves EVERY workspace. Each request acts in the
# workspace of its credential — the SSO token's `ws` claim (required), the
# OAuth grant's `ws`, or the workspace a managed API key was created in.
# Password admin and env API keys act in MCPOCKET_WORKSPACE (else `default`).
# Leave MCPOCKET_SSO_WORKSPACE empty. Needs STORAGE_DRIVER=mongo. With
# MCPOCKET_SEED_ON_FIRST_START, a new workspace is seeded on first use.
# MCPOCKET_MULTI_WORKSPACE=false
# Seed an EMPTY data directory / database from SEED_FILE when the server starts (fresh
# Docker volume). Existing data is never touched. Default: false.
MCPOCKET_SEED_ON_FIRST_START=true
# Seed file for first-start seeding and `npm run seed` (default mock/seed.json;
# /app/mock/seed.json in the image).
# SEED_FILE=./mock/seed.json

# ---------------------------------------------------------------------------
# Initial admin account (web dashboard at /dashboard)
# ---------------------------------------------------------------------------
MCPOCKET_ADMIN_USERNAME=admin
# REQUIRED — without it nobody can sign in (Compose refuses to start while
# it is empty). Pick a strong password; there is deliberately no default.
MCPOCKET_ADMIN_PASSWORD=
# HMAC key for session cookies; generate with `openssl rand -base64 32`.
# Unset = derived from the admin password (changing it logs everyone out).
MCPOCKET_SESSION_SECRET=
MCPOCKET_SESSION_TTL_HOURS=12
# Secure (HTTPS-only) session cookie. Defaults to true in production; `false`
# lets you sign in over plain http://<host>:3000. Set `true` behind HTTPS.
MCPOCKET_COOKIE_SECURE=false
# Failed logins allowed per client IP per window (0 = no throttling).
MCPOCKET_LOGIN_MAX_ATTEMPTS=10
MCPOCKET_LOGIN_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# SSO token login (optional; off unless MCPOCKET_SSO_SECRET is set)
# ---------------------------------------------------------------------------
# A trusted system (MCPocket Cloud or your own identity provider) signs a
# short-lived HS256 JWT ({sub: email, jti, iat, exp ≤ iat+60, ws?}) with this
# shared secret and sends the browser to /auth/sso?token=<jwt>. The person is
# signed in as <email> (`user:<email>` in history). Unset = /auth/sso is 404.
# Generate with `openssl rand -base64 32`. Test link: `npm run sso:token -- you@example.com`.
MCPOCKET_SSO_SECRET=
# When set, the token's `ws` claim must equal this workspace slug.
MCPOCKET_SSO_WORKSPACE=

# ---------------------------------------------------------------------------
# OAuth access tokens on the MCP endpoints (ChatGPT connectors). Off unless
# MCPOCKET_OAUTH_ISSUER is set. Tokens must carry the grant claim
# "mcpocket": { "ws": "<slug>", "role": "readonly|agent|operator" } — see
# README "OAuth clients".
# ---------------------------------------------------------------------------
# MCPOCKET_OAUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# MCPOCKET_OAUTH_JWKS_URL=   (default <issuer>/.well-known/jwks.json)
# MCPOCKET_OAUTH_AUDIENCE=authenticated
# MCPOCKET_OAUTH_WORKSPACE=  (default MCPOCKET_SSO_WORKSPACE)

# ---------------------------------------------------------------------------
# SSO-only mode (optional; for instances managed by MCPocket Cloud or an IdP)
# ---------------------------------------------------------------------------
# Absolute http(s) URL of the external sign-in page. When set, anonymous
# visitors of /dashboard/* and /login are redirected there with the requested
# dashboard path as `?next=/dashboard/...`; the issuer passes it back to
# /auth/sso?next=... (only /dashboard paths are honoured). Invalid URLs are ignored.
MCPOCKET_SSO_LOGIN_URL=
# Where sign-out lands (absolute http(s) URL). Default: MCPOCKET_SSO_LOGIN_URL, else /login.
MCPOCKET_SSO_LOGOUT_URL=
# Set to false to switch password login off: the form is hidden, submissions
# are refused and existing password sessions end. Default: enabled.
MCPOCKET_PASSWORD_LOGIN=

# ---------------------------------------------------------------------------
# API keys (REST + MCP). More keys can be created on the dashboard Access page.
# ---------------------------------------------------------------------------
# `keyId:secret` pairs, comma or newline separated. Clients send
# `Authorization: Bearer <secret>` (or `X-API-Key`). No keys = every API call 401.
# Generate secrets with `openssl rand -hex 24`, e.g.
#   MCPOCKET_API_KEYS=ops:<secret>,worker:<secret2>
MCPOCKET_API_KEYS=
# Roles per env key (`keyId:role`; roles admin|operator|agent|readonly).
MCPOCKET_API_KEY_ROLES=
# Role of env keys not listed above.
MCPOCKET_API_KEY_DEFAULT_ROLE=admin
# Requests per key per minute (managed keys may override; 0 = unlimited).
MCPOCKET_RATE_LIMIT_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Leases, retries & lease sweeper
# ---------------------------------------------------------------------------
MCPOCKET_LEASE_SECONDS=300
MCPOCKET_RETRY_MAX_ATTEMPTS=3
# `exponential` or `fixed`
MCPOCKET_RETRY_BACKOFF=exponential
MCPOCKET_RETRY_DELAY_SECONDS=30
MCPOCKET_RETRY_MAX_DELAY_SECONDS=3600
MCPOCKET_SWEEPER_ENABLED=true
MCPOCKET_SWEEPER_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Agent monitoring (dashboard Agents page)
# ---------------------------------------------------------------------------
MCPOCKET_AGENT_ONLINE_SECONDS=120
MCPOCKET_AGENT_STALE_SECONDS=600

# ---------------------------------------------------------------------------
# Webhooks (transactional outbox dispatcher; needs outbound HTTP)
# ---------------------------------------------------------------------------
MCPOCKET_WEBHOOKS_ENABLED=true
MCPOCKET_WEBHOOK_INTERVAL_SECONDS=5
MCPOCKET_WEBHOOK_MAX_ATTEMPTS=8
MCPOCKET_WEBHOOK_BACKOFF_SECONDS=10
MCPOCKET_WEBHOOK_MAX_BACKOFF_SECONDS=3600
MCPOCKET_WEBHOOK_TIMEOUT_SECONDS=10
MCPOCKET_WEBHOOK_BATCH_SIZE=20
MCPOCKET_WEBHOOK_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Media (S3) — off unless MCPOCKET_S3_BUCKET is set (see README "Media (S3)")
# ---------------------------------------------------------------------------
# Data URIs (data:image/png;base64,...) inside item payload/metadata are
# uploaded on push/import/update and replaced by their URL; POST /api/media
# uploads files directly.
MCPOCKET_S3_BUCKET=
MCPOCKET_S3_REGION=us-east-1
# S3-compatible stores (MinIO, R2, B2, Spaces): endpoint URL. Unset = AWS.
# MCPOCKET_S3_ENDPOINT=http://minio:9000
# Defaults to true when an endpoint is set.
# MCPOCKET_S3_FORCE_PATH_STYLE=
# Unset = AWS SDK default chain (AWS_ACCESS_KEY_ID/..., profile, IAM role).
MCPOCKET_S3_ACCESS_KEY_ID=
MCPOCKET_S3_SECRET_ACCESS_KEY=
# Canned ACL per upload, e.g. public-read (only where bucket ACLs are enabled).
# MCPOCKET_S3_ACL=
# How media links reach the bytes: server (default) = this server streams
# them from a private bucket at /api/media/files/...; bucket = link to the
# bucket directly (must be public).
# MCPOCKET_MEDIA_DELIVERY=server
# Who can open media links served by this server: private (default) = an API
# key, a dashboard session or a signed link from create_media_link /
# POST /api/media/links; public = anyone with the link.
# MCPOCKET_MEDIA_ACCESS=private
# Optional CDN base URL for links; overrides MCPOCKET_MEDIA_DELIVERY.
# MCPOCKET_MEDIA_PUBLIC_URL=https://cdn.example.com
# `<workspace>/` is appended when MCPOCKET_WORKSPACE / MCPOCKET_SSO_WORKSPACE is set.
MCPOCKET_MEDIA_PREFIX=media/
# Max size of one file in bytes (default 50 MiB).
MCPOCKET_MEDIA_MAX_BYTES=52428800
# MIME allowlist, comma separated, wildcards allowed; empty = any type.
# MCPOCKET_MEDIA_ALLOWED_TYPES=image/*,video/*,application/pdf
MCPOCKET_MEDIA_ALLOWED_TYPES=
# Public base URL of this server, used in media links (server delivery) and
# upload links (create_media_upload). Default: the request's origin /
# X-Forwarded-* headers.
# MCPOCKET_PUBLIC_URL=https://pocket.example.com
# ingest_media: max seconds per download (default 120); allow private /
# loopback hosts (local dev only — SSRF risk, default false).
# MCPOCKET_MEDIA_INGEST_TIMEOUT_SECONDS=120
# MCPOCKET_MEDIA_INGEST_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# stdio MCP proxy (bin/mcpocket-stdio.mjs) — read by the proxy process, not
# by the server. Set these in your MCP client's config instead.
# ---------------------------------------------------------------------------
# MCPOCKET_URL=http://localhost:3000
# MCPOCKET_API_KEY=<one secret from MCPOCKET_API_KEYS>
# MCPOCKET_AGENT_ID=my-agent
# Optional: bind the proxy session to one tube (→ /api/mcp/tubes/<id>).
# MCPOCKET_TUBE_ID=<tube id>
# ...or to one folder subtree (→ /api/mcp/folders/<id>); not both.
# MCPOCKET_FOLDER_ID=<folder id>
