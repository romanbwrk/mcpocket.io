{
  "name": "app.mcpocket",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "demo:media": "tsx --env-file=.env scripts/demo-media.ts",
    "migrate:sqlite": "tsx scripts/json-to-sqlite.ts",
    "sso:token": "tsx scripts/mint-sso-token.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:stdio": "node bin/mcpocket-stdio.mjs",
    "build:stdio": "esbuild bin/mcpocket-stdio.mjs --bundle --platform=node --format=esm --target=node22 --minify --outfile=dist/mcpocket-stdio.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mcpocket/core": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "bin": {
    "mcpocket-stdio": "bin/mcpocket-stdio.mjs"
  }
}
